# Optional. Hiro made production API access free from 30 October 2026, so a key
# is not required — it buys higher, more predictable rate limits. Sent as the
# `x-api-key` header (the legacy x-hiro-api-key / x-partner headers are retired).
# Get one at https://platform.hiro.so
HIRO_API_KEY=

# Bearer secret Chainhooks sends as `Authorization: Bearer <secret>` on every
# delivery. Reject any delivery whose header does not match. The Platform shows
# separate testnet and mainnet secrets; never commit either.
CHAINHOOKS_CONSUMER_SECRET=
