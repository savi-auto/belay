# Secrets. src/chain.mjs reads HIRO_API_KEY from the environment, so a local
# .env is the natural place to put it — and the natural way to leak it.
.env
.env.*
!.env.example
.npmrc

# Dependencies
node_modules/
.npm/

# Generated by scripts/benchmark.mjs (crawl output, regenerated on demand)
benchmark.json
benchmark-*.json

# Build and deploy output (the M1 web app lands here)
dist/
build/
out/
.next/
.vercel/
.netlify/

# Test and tooling artefacts
coverage/
*.lcov
.cache/
.playwright-mcp/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS and editor
.DS_Store
Thumbs.db
*.swp
.idea/

# The grant application draft stays local: it carries portal answers and a
# pre-submission checklist that are not meant to be public.
GRANT.md
